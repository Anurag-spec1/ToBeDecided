<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"
    android:fitsSystemWindows="true"
    tools:context=".activity.LoginActivity">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/signIn"
        android:fillViewport="true"
        android:scrollbars="none">

        <carbon.widget.LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <carbon.widget.TextView
                android:id="@+id/constText1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="200dp"
                android:layout_marginEnd="30dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Let's get you"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:textStyle="bold"
                app:carbon_font="@font/plus_jakarta" />

            <carbon.widget.TextView
                android:id="@+id/constText2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="30dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="signed in"
                android:textColor="#36DA77"
                android:textSize="38sp"
                android:textStyle="italic|bold"
                app:carbon_font="@font/plus_jakarta" />

            <carbon.widget.TextView
                android:id="@+id/constText3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="30dp"
                android:maxLines="3"
                android:text="Sign in with the email and password your family admin gave you."
                android:textColor="#C6C9C7"
                android:textSize="17sp" />

            <carbon.widget.TextView
                android:id="@+id/emailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="30dp"
                android:text="Email"
                android:textColor="#F2F2F2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <carbon.widget.LinearLayout
                android:id="@+id/emailBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"
                android:background="#001111"
                android:orientation="horizontal"
                app:carbon_cornerRadius="15dp"
                app:carbon_stroke="#2ED86F"
                app:carbon_strokeWidth="1dp">

                <carbon.widget.EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:background="#001111"
                    android:hint="Enter your email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="20dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/carbon_white_50"
                    android:textSize="18sp" />

            </carbon.widget.LinearLayout>

            <carbon.widget.TextView
                android:id="@+id/passwordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:text="Password"
                android:textColor="#F2F2F2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <carbon.widget.LinearLayout
                android:id="@+id/passwordBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"
                android:background="#001111"
                android:orientation="horizontal"
                app:carbon_cornerRadius="15dp"
                app:carbon_stroke="#2ED86F"
                app:carbon_strokeWidth="1dp">

                <carbon.widget.EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="#001111"
                    android:hint="Your password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingHorizontal="20dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/carbon_white_50"
                    android:textSize="18sp" />

                <carbon.widget.TextView
                    android:id="@+id/togglePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="Hide"
                    android:textColor="#36DA77"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </carbon.widget.LinearLayout>

            <carbon.widget.TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="30dp"
                android:textColor="#FF6B6B"
                android:textSize="15sp"
                android:visibility="gone" />

        </carbon.widget.LinearLayout>
    </ScrollView>

    <carbon.widget.TextView
        android:id="@+id/signIn"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="30dp"
        android:layout_marginVertical="40dp"
        android:background="@drawable/bg_button_gradient"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Sign in"
        android:textColor="#09110d"
        android:textSize="18sp"
        android:textStyle="bold"
        app:carbon_cornerRadius="5dp"
        app:carbon_elevation="5dp" />

</carbon.widget.RelativeLayout>